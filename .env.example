# Copy this file to .env before running docker-compose:
#     cp .env.example .env
# Every variable below has a working default for local demo use.

# ---------- PostgreSQL ----------
POSTGRES_DB=fraud_db
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- Django ----------
# Replace with a long random string for anything other than a local demo.
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# Set to True to run Django against a local SQLite file instead of PostgreSQL.
# Handy for running the test suite on a laptop with no Postgres/Docker.
# Leave False for the normal docker-compose stack.
USE_SQLITE=False

# ---------- Frontend ----------
# Base URL the React app uses to reach the Django API.
VITE_API_BASE_URL=http://localhost:8000/api
