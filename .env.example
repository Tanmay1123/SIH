# Copy this file to .env before running docker-compose:
#     cp .env.example .env
# Every variable below has a working default for local demo use.

# ---------- PostgreSQL ----------
POSTGRES_DB=fraud_db
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- Django ----------
# Replace with a long random string for anything other than a local demo.
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# Set to True to run Django against a local SQLite file instead of PostgreSQL.
# Handy for running the test suite on a laptop with no Postgres/Docker.
# Leave False for the normal docker-compose stack.
USE_SQLITE=False

# ---------- Detection policy ----------
# Score at or above which an alert counts as high risk. A policy choice, not a
# constant - every detection run and every ledger block records the threshold
# that was in force when it ran.
RISK_THRESHOLD=70

# ---------- Email (case reports to the supervisor) ----------
# Leave EMAIL_HOST blank and reports are printed to the backend console instead
# of being sent, so the whole workflow is demonstrable before any credentials
# exist.
#
# Gmail:   smtp.gmail.com / 587 / TLS - and EMAIL_HOST_PASSWORD must be a
#          Google "App password", not your normal account password.
# Outlook: smtp-mail.outlook.com / 587 / TLS
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=

# Comma-separated. Copied on every case report, alongside the officer who
# issued it. Anyone in the "Supervisors" group with an email on their account
# is added automatically as well.
REPORT_SUPERVISOR_EMAILS=
SUPERVISOR_GROUP_NAME=Supervisors

# ---------- Frontend ----------
# Base URL the React app uses to reach the Django API.
VITE_API_BASE_URL=http://localhost:8000/api
