# Where the Django API lives. Vite bakes this into the bundle at BUILD time,
# so changing it requires a redeploy - setting it on a live deployment does
# nothing until the next build.
#
# Local development (leave unset and it defaults to this anyway):
#   VITE_API_BASE_URL=http://localhost:8000/api
#
# Production - note the /api suffix, and no trailing slash:
#   VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api
